# Claude Code per-machine settings
.claude/settings.local.json

# Slash-command symlinks (dev convenience for spectastic itself —
# real consumers get copies via `spectastic init` someday).
.claude/commands/

# Subagent-definition copies (spec 044) — local copy of the tracked agents/
# sources, same footing as .claude/commands/; regenerated by the manual cp sync.
.claude/agents/

# Claude Code worktrees (per-session scratch; never tracked)
.claude/worktrees/

# macOS
.DS_Store

# Editor cruft
*.swp
*~
.idea/
.vscode/

# Inliner output target
dist/

# Node monorepo (Tier 1: @spectastic/schema + @spectastic/cli)
node_modules/
.vitest/
*.tsbuildinfo
packages/*/dist/
packages/cli/_bundled/
packages/cli/_bundled.tmp/
# Packaged extension build artifact (sideload only — no marketplace release)
*.vsix

# Python venv
.venv/
__pycache__

# Playwright MCP scratch screenshots (transient)
.playwright-mcp/

# Playwright test run artifacts (transient)
test-results/

# Ephemeral explain --course output (019-explain-course)
.spectastic/

# Generated Playwright fixtures (course gate test)
tests/fixtures/*.generated.html

# Ephemeral explore ledgers (022-explore) — the rich explore.html ledger is
# git-ignored (like --course); the tracked quarantine.json marker is NOT, so the
# anti-ship guard stays visible to teammates + CI (FR-004, D-002).
explorations/**/explore.html
