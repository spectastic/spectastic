{
	"name": "spectastic",
	"version": "0.1.0-pre",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"build": "pnpm -r build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"typecheck": "tsc -p packages/schema --noEmit && tsc -p packages/corpus --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/vscode --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test:coverage": "vitest run --coverage",
		"patch-coverage": "node scripts/patch-coverage.mjs",
		"bench": "node bench/measure.mjs",
		"bench:canvas": "node bench/canvas-paint.mjs",
		"test:smoke": "vitest run -c vitest.smoke.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.0",
		"@biomejs/biome": "^2.5.6",
		"@playwright/test": "^1.62.1",
		"@types/node": "^20.16.0",
		"@vitest/coverage-v8": "2.1.9",
		"dependency-cruiser": "^17.4.3",
		"tsup": "^8.3.0",
		"typescript": "^5.7.0",
		"vitest": "^2.1.0"
	}
}
