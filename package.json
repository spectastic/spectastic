{
	"name": "spectastic",
	"version": "0.1.0-pre",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.27.0",
	"scripts": {
		"build": "pnpm -r build",
		"test": "vitest run",
		"test:perf": "vitest run --config vitest.perf.config.ts",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"typecheck": "tsc -p packages/schema --noEmit && tsc -p packages/render --noEmit && tsc -p packages/corpus --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/vscode --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test:coverage": "vitest run --coverage",
		"patch-coverage": "node scripts/patch-coverage.mjs",
		"render-ci-examples": "node scripts/render-ci-examples.mjs",
		"bench": "node bench/measure.mjs",
		"bench:canvas": "node bench/canvas-paint.mjs",
		"test:smoke": "vitest run -c vitest.smoke.config.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.62.1",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "5.0.3",
		"dependency-cruiser": "^18.5.0",
		"tsup": "^8.3.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	}
}
