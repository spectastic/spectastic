{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "packages/*/src/**",
      "packages/*/test/**",
      "packages/*/*.config.ts",
      "test/**",
      "tests/**",
      "scripts/**",
      "bench/**",
      "vitest.config.ts",
      "vitest.smoke.config.ts",
      "playwright.config.ts",
      "!**/dist",
      "!**/_bundled"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Tuned down, recorded reason (068-enterprise-enforce-floor FR-002):
        // the codebase runs under tsconfig.base.json's `noUncheckedIndexedAccess`,
        // which makes every indexed/array access `T | undefined` by design — the
        // deliberate, well-understood `!` after a known-safe access (e.g. a
        // just-asserted `.length`, a destructure the code just validated) is the
        // standard idiom under that setting, not a bug. 141 sites (86 in tests, 55
        // in src) at the spike (plan §3); disabling this rule stays honest rather
        // than papering over noUncheckedIndexedAccess's own tradeoff with a wall of
        // unnecessary re-narrowing. tsc's own strictness is the real backstop here.
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "html": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "css": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "graphql": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "grit": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  }
}
