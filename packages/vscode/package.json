{
  "name": "spectastic-vscode",
  "version": "0.1.0-pre.0",
  "private": true,
  "displayName": "Spectastic Lifecycle Canvas",
  "description": "An in-editor canvas of one spec's lifecycle — principles → … → triage as connected cards. Read-only; opens each rendered artifact in a click.",
  "publisher": "spectastic",
  "license": "MIT",
  "homepage": "https://github.com/spectastic/spectastic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectastic/spectastic.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/spectastic/spectastic/issues"
  },
  "keywords": [
    "spectastic",
    "spec-driven-development",
    "specs",
    "lifecycle",
    "canvas",
    "vscode-extension",
    "webview",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/host.cjs",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spectastic",
          "title": "Spectastic",
          "icon": "media/favicon.svg"
        }
      ]
    },
    "views": {
      "spectastic": [
        {
          "type": "webview",
          "id": "spectastic.lifecycleCanvas",
          "name": "Lifecycle canvas"
        }
      ]
    },
    "commands": [
      {
        "command": "spectastic.selectSpec",
        "title": "Select Spec",
        "category": "Spectastic",
        "icon": "$(list-selection)"
      },
      {
        "command": "spectastic.toggleOrientation",
        "title": "Toggle Layout Orientation",
        "category": "Spectastic",
        "icon": "$(layout)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "spectastic.selectSpec",
          "when": "view == spectastic.lifecycleCanvas",
          "group": "navigation"
        },
        {
          "command": "spectastic.toggleOrientation",
          "when": "view == spectastic.lifecycleCanvas",
          "group": "navigation"
        }
      ]
    }
  },
  "files": [
    "dist",
    "media",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@spectastic/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
