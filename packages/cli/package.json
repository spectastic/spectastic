{
  "name": "@spectastic/cli",
  "version": "0.1.0-pre.8",
  "description": "Spectastic CLI: `init` bootstraps a spec-driven project; `validate` checks spec-html artifacts. Emits human, JSON, or SARIF.",
  "keywords": [
    "spectastic",
    "spec-driven-development",
    "specs",
    "lifecycle",
    "html",
    "linter",
    "validator",
    "ci",
    "sarif",
    "init",
    "scaffold",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/spectastic/spectastic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectastic/spectastic.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/spectastic/spectastic/issues"
  },
  "type": "module",
  "bin": {
    "spectastic": "./bin/spectastic"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "bin", "_bundled", "README.md"],
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "build": "node scripts/prebuild.mjs && tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "@spectastic/core": "workspace:*",
    "@spectastic/schema": "workspace:*",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0",
    "tinyglobby": "^0.2.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
