{
  "name": "@spectastic/core",
  "version": "0.1.0-pre.9",
  "description": "Spectastic verb kernel. Single async function per slash-command verb; consumed by @spectastic/cli, the future MCP server, the future VS Code extension, and the future web editor without per-surface duplication.",
  "keywords": [
    "spectastic",
    "spec-driven-development",
    "specs",
    "lifecycle",
    "kernel",
    "verbs",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/spectastic/spectastic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectastic/spectastic.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/spectastic/spectastic/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands/validate": {
      "types": "./dist/commands/validate.d.ts",
      "default": "./dist/commands/validate.js"
    },
    "./commands/triage": {
      "types": "./dist/commands/triage.d.ts",
      "default": "./dist/commands/triage.js"
    },
    "./providers/node-fs": {
      "types": "./dist/providers/node-fs.d.ts",
      "default": "./dist/providers/node-fs.js"
    },
    "./providers/claude": {
      "types": "./dist/providers/claude.d.ts",
      "default": "./dist/providers/claude.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@spectastic/schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
