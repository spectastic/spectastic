{
  "name": "@spectastic/core",
  "version": "0.1.0-pre.17",
  "description": "Spectastic verb kernel. Single async function per slash-command verb; consumed by @spectastic/cli, the future MCP server, the future VS Code extension, and the future web editor without per-surface duplication.",
  "keywords": [
    "spectastic",
    "spec-driven-development",
    "specs",
    "lifecycle",
    "kernel",
    "verbs",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/spectastic/spectastic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectastic/spectastic.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/spectastic/spectastic/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./commands/validate": {
      "types": "./dist/commands/validate.d.ts",
      "default": "./dist/commands/validate.js"
    },
    "./commands/triage": {
      "types": "./dist/commands/triage.d.ts",
      "default": "./dist/commands/triage.js"
    },
    "./commands/principles": {
      "types": "./dist/commands/principles.d.ts",
      "default": "./dist/commands/principles.js"
    },
    "./commands/tasks": {
      "types": "./dist/commands/tasks.d.ts",
      "default": "./dist/commands/tasks.js"
    },
    "./commands/restore-marker": {
      "types": "./dist/commands/restore-marker.d.ts",
      "default": "./dist/commands/restore-marker.js"
    },
    "./commands/apply": {
      "types": "./dist/commands/apply.d.ts",
      "default": "./dist/commands/apply.js"
    },
    "./providers/stub": {
      "types": "./dist/providers/stub.d.ts",
      "default": "./dist/providers/stub.js"
    },
    "./commands/spec": {
      "types": "./dist/commands/spec.d.ts",
      "default": "./dist/commands/spec.js"
    },
    "./commands/plan": {
      "types": "./dist/commands/plan.d.ts",
      "default": "./dist/commands/plan.js"
    },
    "./commands/propose": {
      "types": "./dist/commands/propose.d.ts",
      "default": "./dist/commands/propose.js"
    },
    "./commands/implement": {
      "types": "./dist/commands/implement.d.ts",
      "default": "./dist/commands/implement.js"
    },
    "./commands/course": {
      "types": "./dist/commands/course.d.ts",
      "default": "./dist/commands/course.js"
    },
    "./commands/verify": {
      "types": "./dist/commands/verify.d.ts",
      "default": "./dist/commands/verify.js"
    },
    "./commands/explore": {
      "types": "./dist/commands/explore.d.ts",
      "default": "./dist/commands/explore.js"
    },
    "./commands/graduate": {
      "types": "./dist/commands/graduate.d.ts",
      "default": "./dist/commands/graduate.js"
    },
    "./providers/node-fs": {
      "types": "./dist/providers/node-fs.d.ts",
      "default": "./dist/providers/node-fs.js"
    },
    "./providers/claude": {
      "types": "./dist/providers/claude.d.ts",
      "default": "./dist/providers/claude.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@spectastic/schema": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
