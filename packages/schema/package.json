{
	"name": "@spectastic/schema",
	"version": "0.1.0-pre.26",
	"description": "Spec-html validation schema and engine. The TypeScript module form of the spec-* vocabulary's grammar — used by @spectastic/cli, MCP servers, and editor extensions.",
	"keywords": [
		"spectastic",
		"spec-driven-development",
		"specs",
		"html",
		"linter",
		"validator",
		"ast",
		"parse5",
		"ci",
		"sarif",
		"typescript"
	],
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"homepage": "https://github.com/spectastic/spectastic#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spectastic/spectastic.git",
		"directory": "packages/schema"
	},
	"bugs": {
		"url": "https://github.com/spectastic/spectastic/issues"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./parser": {
			"types": "./dist/parser.d.ts",
			"default": "./dist/parser.js"
		},
		"./slo": {
			"types": "./dist/slo-shared.d.ts",
			"default": "./dist/slo-shared.js"
		},
		"./citation": {
			"types": "./dist/citation-shared.d.ts",
			"default": "./dist/citation-shared.js"
		},
		"./fence": {
			"types": "./dist/fence.d.ts",
			"default": "./dist/fence.js"
		},
		"./project": {
			"types": "./dist/project-shared.d.ts",
			"default": "./dist/project-shared.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"default": "./dist/config/index.js"
		},
		"./contract": {
			"types": "./dist/contract-shared.d.ts",
			"default": "./dist/contract-shared.js"
		},
		"./visual": {
			"types": "./dist/visual-shared.d.ts",
			"default": "./dist/visual-shared.js"
		},
		"./variant-grid": {
			"types": "./dist/variant-grid.d.ts",
			"default": "./dist/variant-grid.js"
		},
		"./visual-vocabulary": {
			"types": "./dist/visual-vocabulary.d.ts",
			"default": "./dist/visual-vocabulary.js"
		},
		"./conformance": {
			"types": "./dist/conformance.d.ts",
			"default": "./dist/conformance.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup && node scripts/gen-schema.mjs",
		"test": "vitest run"
	},
	"dependencies": {
		"parse5": "^8.0.1"
	},
	"devDependencies": {
		"tinyglobby": "^0.2.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
