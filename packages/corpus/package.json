{
  "name": "@spectastic/corpus",
  "version": "0.1.0-pre.1",
  "description": "Spectastic corpus subsystem — curation, citation, and provenance for a knowledge/ corpus. A library other spectastic packages depend on, and a standalone spectastic-corpus binary usable without the SDD lifecycle.",
  "keywords": [
    "spectastic",
    "knowledge-base",
    "corpus",
    "citation",
    "provenance",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/spectastic/spectastic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectastic/spectastic.git",
    "directory": "packages/corpus"
  },
  "bugs": {
    "url": "https://github.com/spectastic/spectastic/issues"
  },
  "type": "module",
  "bin": {
    "spectastic-corpus": "./bin/spectastic-corpus"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@spectastic/schema": "workspace:*",
    "commander": "^12.1.0",
    "yaml": "^2.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
