{
  "$description": "The light mode context. Semantic names only — a screen never references a mode file directly, it references color.* and the resolver supplies the context.",
  "color": {
    "$type": "color",
    "surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" } },
    "surface-sunken": { "$value": { "colorSpace": "srgb", "components": [0.949, 0.949, 0.969], "alpha": 1, "hex": "#f2f2f7" } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 1, "hex": "#000000" } },
    "ink-soft": { "$value": { "colorSpace": "srgb", "components": [0.235, 0.235, 0.263], "alpha": 0.6, "hex": "#3c3c43" } },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0, 0.478, 1], "alpha": 1, "hex": "#007aff" } },
    "danger": { "$value": { "colorSpace": "srgb", "components": [1, 0.231, 0.188], "alpha": 1, "hex": "#ff3b30" } },
    "warning": { "$value": { "colorSpace": "srgb", "components": [1, 0.584, 0], "alpha": 1, "hex": "#ff9500" } }
  }
}
