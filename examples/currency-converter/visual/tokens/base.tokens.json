{
  "$description": "DTCG 2025.10 primitives. Mode-independent: anything whose value changes between light and dark lives in the mode files and is referenced from the semantic layer, not here.",
  "space": {
    "$type": "dimension",
    "100": { "$value": { "value": 4, "unit": "px" } },
    "200": { "$value": { "value": 8, "unit": "px" } },
    "300": { "$value": { "value": 16, "unit": "px" } },
    "400": { "$value": { "value": 24, "unit": "px" } },
    "500": { "$value": { "value": 32, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "card": { "$value": { "value": 14, "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "$description": "The 44pt floor is the platform's, not this project's — it is recorded here so a measurement can fail against it.",
    "tap-target-min": { "$value": { "value": 44, "unit": "px" } }
  },
  "type": {
    "$type": "typography",
    "amount": {
      "$value": {
        "fontFamily": ["SF Pro Display", "system-ui"],
        "fontSize": { "value": 40, "unit": "px" },
        "fontWeight": 600,
        "lineHeight": 1.1,
        "letterSpacing": { "value": -0.5, "unit": "px" }
      },
      "$description": "Scales with Dynamic Type. The px value is the size at the default content size category, never a fixed size."
    },
    "body": {
      "$value": {
        "fontFamily": ["SF Pro Text", "system-ui"],
        "fontSize": { "value": 17, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.4
      }
    },
    "caption": {
      "$value": {
        "fontFamily": ["SF Pro Text", "system-ui"],
        "fontSize": { "value": 13, "unit": "px" },
        "fontWeight": 400,
        "lineHeight": 1.3
      }
    }
  },
  "motion": {
    "rate-refresh": {
      "$type": "transition",
      "$value": {
        "duration": { "value": 220, "unit": "ms" },
        "delay": { "value": 0, "unit": "ms" },
        "timingFunction": [0.4, 0, 0.2, 1]
      }
    }
  },
  "legacy": {
    "accent": {
      "$type": "color",
      "$value": { "colorSpace": "srgb", "components": [0.0, 0.48, 1.0], "alpha": 1, "hex": "#007aff" },
      "$deprecated": "Use {color.accent} — the semantic token that resolves per mode. Removal is a MAJOR bump; see visual/variants.html."
    }
  }
}
