{
  "$description": "The dark mode context. Same semantic names as light; only the values differ. A name present in one mode file and absent from the other is a defect the resolver cannot see, which is why both files are authored together.",
  "color": {
    "$type": "color",
    "surface": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 1, "hex": "#000000" } },
    "surface-sunken": { "$value": { "colorSpace": "srgb", "components": [0.110, 0.110, 0.118], "alpha": 1, "hex": "#1c1c1e" } },
    "ink": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1, "hex": "#ffffff" } },
    "ink-soft": { "$value": { "colorSpace": "srgb", "components": [0.922, 0.922, 0.961], "alpha": 0.6, "hex": "#ebebf5" } },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.518, 1], "alpha": 1, "hex": "#0a84ff" } },
    "danger": { "$value": { "colorSpace": "srgb", "components": [1, 0.271, 0.227], "alpha": 1, "hex": "#ff453a" } },
    "warning": { "$value": { "colorSpace": "srgb", "components": [1, 0.624, 0.039], "alpha": 1, "hex": "#ff9f0a" } }
  }
}
