#!/usr/bin/env python3
"""spectastic — bootstrap single-file HTML spec tooling in a project.

Lays down the lifecycle scaffolding (slash commands, design-system
assets, scaffold templates) so a fresh directory can run `/spectastic.*`
end-to-end. Runtime invariant: Python 3.9+ standard library only.

Usage:
    spectastic init           # write scaffolding into the current directory
    spectastic init --force   # overwrite conflicts without prompting
"""

import argparse
import sys

REQUIRED_PYTHON = (3, 9)


def _check_python_version() -> None:
    if sys.version_info < REQUIRED_PYTHON:
        major, minor = REQUIRED_PYTHON
        running = f"{sys.version_info.major}.{sys.version_info.minor}"
        print(
            f"spectastic requires Python {major}.{minor}+; this interpreter is {running}.",
            file=sys.stderr,
        )
        sys.exit(2)


def _cmd_init(args: argparse.Namespace) -> int:
    return 0


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="spectastic",
        description="Bootstrap single-file HTML spec tooling into the current directory.",
    )
    subs = parser.add_subparsers(dest="cmd", metavar="command")

    init = subs.add_parser(
        "init",
        help="Write spectastic scaffolding (commands, assets, templates) into the cwd.",
        description="Write spectastic scaffolding (commands, assets, templates) into the cwd.",
    )
    init.add_argument(
        "--force",
        action="store_true",
        help="Overwrite existing files without prompting.",
    )
    init.set_defaults(func=_cmd_init)

    return parser


def main(argv=None) -> int:
    _check_python_version()
    parser = _build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "cmd", None):
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
